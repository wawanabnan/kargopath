# Production Environment Variables
# Copy this file to /var/www/kargopath/backend/.env and update values

# Django Settings
SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-KEY-MINIMUM-50-CHARACTERS
DEBUG=False
ALLOWED_HOSTS=kargopath.dakarash.co.id,103.127.99.53,localhost,127.0.0.1

# Database (MySQL)
DB_ENGINE=django.db.backends.mysql
DB_NAME=kargopath
DB_USER=kargopath_user
DB_PASSWORD=your-secure-password-change-this
DB_HOST=localhost
DB_PORT=3306

# CORS Settings (Frontend URL)
CORS_ALLOWED_ORIGINS=https://kargopath.dakarash.co.id,http://kargopath.dakarash.co.id

